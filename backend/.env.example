# ─────────────────────────────────────────────────────────────
# InviteFlow backend environment.  Copy to `.env` and fill in.
# ─────────────────────────────────────────────────────────────

# Runtime
NODE_ENV=development
PORT=4000

# Public URL of the frontend (used in invitation/RSVP links + CORS)
APP_URL=http://localhost:3000
# Comma-separated CORS allowlist
CORS_ORIGINS=http://localhost:3000

# Database — Microsoft SQL Server (Prisma `sqlserver` provider).
# Create the database first:  CREATE DATABASE inviteflow;
#
# SQL auth (e.g. SQL Server Express / Developer with a sa or app login):
DATABASE_URL="sqlserver://localhost:1433;database=inviteflow;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true"
#
# Alternatives (uncomment ONE and comment the line above):
#  • Windows authentication (full instance):
#    DATABASE_URL="sqlserver://localhost:1433;database=inviteflow;integratedSecurity=true;trustServerCertificate=true"
#  • LocalDB (Visual Studio / SQL Server Express LocalDB):
#    DATABASE_URL="sqlserver://localhost\\MSSQLLocalDB;database=inviteflow;integratedSecurity=true;trustServerCertificate=true"
#  • Named instance (e.g. SQLEXPRESS):
#    DATABASE_URL="sqlserver://localhost\\SQLEXPRESS;database=inviteflow;user=sa;password=Your_password123;encrypt=true;trustServerCertificate=true"

# Background worker — Redis-free DB-polling scheduler (delivers scheduled
# messages + fires reminders). Runs IN-PROCESS inside the API by default.
#   SCHEDULER=off        → do NOT run jobs in the API (use a separate `npm run worker`)
#   WORKER_POLL_MS=30000 → how often to check for due messages/reminders
SCHEDULER=inline
WORKER_POLL_MS=30000

# Redis — only needed if you later upgrade the worker to BullMQ (optional).
REDIS_URL=redis://localhost:6379

# JWT secrets — generate strong random values for production!
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# AI — leave OPENAI_API_KEY empty to use the built-in mock provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# WhatsApp Business Cloud API — leave empty to use the mock provider
WHATSAPP_PROVIDER=mock
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=inviteflow-verify
WHATSAPP_APP_SECRET=
